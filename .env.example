# Flask Environment Configuration Example
# Copy this file to .env and update the values

# Secret key for Flask sessions (generate a random string for production)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Flask environment (development or production)
FLASK_ENV=development

# Database path (default: instance directory)
# DATABASE_PATH=instance

# Port for the application (default: 5000)
# PORT=5000
